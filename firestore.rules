// ===============================================================
// Assumed Data Model
// ===============================================================
// sharedLists/{listId}
//   ownerUid: string, immutable; anonymous Firebase Auth UID
//   name: string, 1–80 characters
//   payload: string, JSON-encoded grocery list, at most 250 KB
//   createdAt: timestamp, immutable server timestamp
//   updatedAt: timestamp, current server timestamp
// sharedLists/{listId}/members/{uid}
//   uid: string, immutable and equal to document ID
//   joinedAt: timestamp, immutable server timestamp
//   inviteCode: optional string, 20–64 characters; retained only to prove a join
// shareInvites/{inviteCode}
//   listId: string, 20–64 characters, references a sharedLists document
//   ownerUid: string, immutable and equal to the list owner
//   createdAt: timestamp, immutable server timestamp
// No personally identifiable information is stored.
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =============================================================
    // Helper Functions
    // =============================================================
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function uidUnchanged() { return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid; }
    function uidNotModified() { return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid; }
    function listDoc(listId) { return /databases/$(database)/documents/sharedLists/$(listId); }
    function isMember(listId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/sharedLists/$(listId)/members/$(request.auth.uid));
    }
    function isListOwner(listId) {
      return isAuthenticated() && exists(listDoc(listId)) && get(listDoc(listId)).data.ownerUid == request.auth.uid;
    }
    function isValidSharedList(data) {
      return data.keys().hasAll(['ownerUid', 'name', 'payload', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'name', 'payload', 'createdAt', 'updatedAt']) &&
        data.ownerUid is string && data.ownerUid.size() >= 16 && data.ownerUid.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.payload is string && data.payload.size() <= 250000 &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function isValidMember(data, memberId) {
      return data.keys().hasAll(['uid', 'joinedAt']) &&
        data.keys().hasOnly(['uid', 'joinedAt', 'inviteCode']) &&
        data.uid is string && data.uid == memberId && data.uid.size() >= 16 && data.uid.size() <= 128 &&
        data.joinedAt is timestamp &&
        (!('inviteCode' in data) || (data.inviteCode is string && data.inviteCode.size() >= 20 && data.inviteCode.size() <= 64));
    }
    function hasValidInvite(listId, data) {
      return 'inviteCode' in data &&
        exists(/databases/$(database)/documents/shareInvites/$(data.inviteCode)) &&
        get(/databases/$(database)/documents/shareInvites/$(data.inviteCode)).data.listId == listId;
    }
    function ownsListBeingCreated(listId) {
      return existsAfter(listDoc(listId)) && getAfter(listDoc(listId)).data.ownerUid == request.auth.uid;
    }
    function isValidInvite(data) {
      return data.keys().hasAll(['listId', 'ownerUid', 'createdAt']) &&
        data.keys().hasOnly(['listId', 'ownerUid', 'createdAt']) &&
        data.listId is string && data.listId.size() >= 20 && data.listId.size() <= 64 &&
        data.ownerUid is string && data.ownerUid.size() >= 16 && data.ownerUid.size() <= 128 &&
        data.createdAt is timestamp;
    }

    match /sharedLists/{listId} {
      allow create: if isAuthenticated() && isValidSharedList(request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow get: if isMember(listId);
      allow list: if false;
      allow update: if isMember(listId) && isValidSharedList(request.resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
      allow delete: if isListOwner(listId);

      match /members/{memberId} {
        allow create: if isAuthenticated() && memberId == request.auth.uid && uidUnchanged() &&
          isValidMember(request.resource.data, memberId) && request.resource.data.joinedAt == request.time &&
          (ownsListBeingCreated(listId) || hasValidInvite(listId, request.resource.data));
        allow get: if isAuthenticated() && memberId == request.auth.uid;
        allow list, update, delete: if false;
      }
    }

    match /shareInvites/{inviteCode} {
      allow create: if isAuthenticated() && inviteCode.size() >= 20 && inviteCode.size() <= 64 &&
        isValidInvite(request.resource.data) && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.createdAt == request.time && isListOwner(request.resource.data.listId);
      // A random, high-entropy code is the invitation capability. Users cannot list invitations.
      allow get: if isAuthenticated();
      allow list, update, delete: if false;
    }
  }
}

